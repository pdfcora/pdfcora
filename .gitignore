# PDFium artifacts — fetched, never committed. See scripts/fetch-vendor.sh
vendor/

# Build output
build/
.build/
dist/
web/dist/
*.log

# Generated Xcode project — project.yml is the source of truth
ios/Demo/*.xcodeproj
samples/*-ios/*.xcodeproj

# Gradle
.gradle/
android/.gradle/
android/build/
android/*/build/
local.properties

# Node
node_modules/

# The JNI engine, built from vendor/ by scripts/build-jni.sh like every other binary
java/src/main/resources/native/
java/build/
java/.gradle/

# macOS
.DS_Store
xcuserdata/
*.xcuserstate

# Android native build intermediates
.cxx/

# Sample output
samples/agents-web/redacted.pdf

# Generated large test documents (scale testing)
conformance/large/
conformance/robustness-report.json

# API references generated into the website by `scripts/make-docs.sh --site`: 49 MB and
# thousands of files that change with every API change. Built at deploy time instead.
site/api/

# Wrangler (Cloudflare CLI) local cache: account and project IDs, not source.
.wrangler/
