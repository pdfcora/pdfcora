{
  "name": "pdfcora-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"scripts/*.test.mjs\" \"tools/host/*.test.mjs\" \"conformance/*.test.mjs\"",
    "manifest": "node scripts/make-vendor-manifest.mjs",
    "conformance:validate": "node conformance/validate.mjs",
    "conformance:generate": "node conformance/generate.mjs",
    "test:all": "npm test && cd web && npm test"
  }
}
