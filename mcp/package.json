{
  "name": "pdfiumkit-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives AI agents PdfiumKit's PDF tools",
  "type": "module",
  "bin": { "pdfiumkit-mcp": "./dist/main.js" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --import ./dist-test/license-setup.js --test \"dist-test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdfiumkit/web": "file:../web",
    "pdfiumkit-ai": "file:../web-ai"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
