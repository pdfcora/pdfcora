{
  "name": "pdfcora-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives AI agents PDFCora's PDF tools",
  "license": "MIT",
  "homepage": "https://pdfcora.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdfcora/pdfcora.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/pdfcora/pdfcora/issues"
  },
  "type": "module",
  "bin": { "pdfcora-mcp": "./dist/main.js" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test \"dist-test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pdfcora/web": "file:../web",
    "@pdfcora/web-ai": "file:../web-ai"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
