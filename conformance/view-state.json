{
  "version": 1,
  "note": "Shared by all three platforms. Expected offsets were computed by independent arithmetic, not by running the SDK, so this checks the implementation rather than copying it. Scale is Float on Android and Double elsewhere, so compare to single precision (1e-4), never exactly. Rotation travels as DEGREES (0/90/180/270). iOS and Android hold it as PDFium's quarter-turn index 0-3, so they convert at the codec boundary; a platform that writes the index instead fails the rotation case below. The editCases below are edit events: each carries the wire form and the arguments a peer must end up calling with. Hand-written, not generated by any SDK.",
  "cases": [
    {
      "name": "a free zoom is adopted verbatim by every receiver",
      "page": {
        "width": 612,
        "height": 792
      },
      "wire": {
        "v": 1,
        "sequence": 1,
        "sessionId": "presenter",
        "origin": "local",
        "change": {
          "kind": "viewport",
          "state": {
            "pageIndex": 0,
            "center": {
              "x": 306,
              "y": 396
            },
            "zoom": {
              "scale": 2,
              "mode": "free"
            },
            "rotation": 0,
            "layout": "single"
          }
        }
      },
      "receivers": [
        {
          "viewport": {
            "width": 390,
            "height": 700
          },
          "expectScale": 2,
          "expectScrollOffset": {
            "x": 417.0,
            "y": 442.0
          }
        },
        {
          "viewport": {
            "width": 1200,
            "height": 800
          },
          "expectScale": 2,
          "expectScrollOffset": {
            "x": 12.0,
            "y": 392.0
          }
        }
      ]
    },
    {
      "name": "fit-width is re-derived per receiver, so the scales differ",
      "page": {
        "width": 612,
        "height": 792
      },
      "wire": {
        "v": 1,
        "sequence": 2,
        "sessionId": "presenter",
        "origin": "local",
        "change": {
          "kind": "viewport",
          "state": {
            "pageIndex": 0,
            "center": {
              "x": 306,
              "y": 396
            },
            "zoom": {
              "scale": 0.6372549019607843,
              "mode": "fitWidth"
            },
            "rotation": 0,
            "layout": "single"
          }
        }
      },
      "receivers": [
        {
          "viewport": {
            "width": 390,
            "height": 700
          },
          "expectScale": 0.637255,
          "expectScrollOffset": {
            "x": 0.0,
            "y": 0.0
          }
        },
        {
          "viewport": {
            "width": 1200,
            "height": 800
          },
          "expectScale": 1.960784,
          "expectScrollOffset": {
            "x": 0.0,
            "y": 376.4706
          }
        }
      ]
    },
    {
      "name": "a centre near the page edge clamps rather than scrolling out of range",
      "page": {
        "width": 612,
        "height": 792
      },
      "wire": {
        "v": 1,
        "sequence": 3,
        "sessionId": "presenter",
        "origin": "local",
        "change": {
          "kind": "viewport",
          "state": {
            "pageIndex": 0,
            "center": {
              "x": 10,
              "y": 780
            },
            "zoom": {
              "scale": 3,
              "mode": "free"
            },
            "rotation": 0,
            "layout": "single"
          }
        }
      },
      "receivers": [
        {
          "viewport": {
            "width": 390,
            "height": 700
          },
          "expectScale": 3,
          "expectScrollOffset": {
            "x": 0.0,
            "y": 0.0
          }
        },
        {
          "viewport": {
            "width": 1200,
            "height": 800
          },
          "expectScale": 3,
          "expectScrollOffset": {
            "x": 0.0,
            "y": 0.0
          }
        }
      ]
    },
    {
      "name": "a centre near the far corner clamps to the end of the range, not to zero",
      "page": {
        "width": 612,
        "height": 792
      },
      "wire": {
        "v": 1,
        "sequence": 4,
        "sessionId": "presenter",
        "origin": "local",
        "change": {
          "kind": "viewport",
          "state": {
            "pageIndex": 0,
            "center": {
              "x": 600,
              "y": 10
            },
            "zoom": {
              "scale": 3,
              "mode": "free"
            },
            "rotation": 0,
            "layout": "single"
          }
        }
      },
      "receivers": [
        {
          "viewport": {
            "width": 390,
            "height": 700
          },
          "expectScale": 3,
          "expectScrollOffset": {
            "x": 1446,
            "y": 1676
          }
        },
        {
          "viewport": {
            "width": 1200,
            "height": 800
          },
          "expectScale": 3,
          "expectScrollOffset": {
            "x": 636,
            "y": 1576
          }
        }
      ]
    },
    {
      "name": "rotation travels as degrees, not as a quarter-turn index",
      "page": {
        "width": 612,
        "height": 792
      },
      "wire": {
        "v": 1,
        "sequence": 5,
        "sessionId": "presenter",
        "origin": "local",
        "change": {
          "kind": "viewport",
          "state": {
            "pageIndex": 0,
            "center": {
              "x": 306,
              "y": 396
            },
            "zoom": {
              "scale": 2,
              "mode": "free"
            },
            "rotation": 90,
            "layout": "continuous"
          }
        }
      },
      "expectRotationDegrees": 90,
      "expectLayout": "continuous",
      "receivers": [
        {
          "viewport": {
            "width": 390,
            "height": 700
          },
          "expectScale": 2,
          "expectScrollOffset": {
            "x": 417.0,
            "y": 442.0
          }
        },
        {
          "viewport": {
            "width": 1200,
            "height": 800
          },
          "expectScale": 2,
          "expectScrollOffset": {
            "x": 12.0,
            "y": 392.0
          }
        }
      ]
    }
  ],
  "editCases": [
    {
      "name": "a note carries its rect, contents and colour",
      "wire": {
        "v": 1,
        "sequence": 1,
        "sessionId": "presenter",
        "origin": "local",
        "documentFingerprint": "abc12345-900",
        "change": {
          "kind": "edit",
          "edit": {
            "kind": "noteAdded",
            "page": 0,
            "rect": {
              "left": 10,
              "bottom": 10,
              "right": 30,
              "top": 30
            },
            "contents": "hello",
            "color": {
              "red": 255,
              "green": 235,
              "blue": 59,
              "alpha": 255
            }
          }
        }
      },
      "expect": {
        "kind": "noteAdded",
        "page": 0,
        "contents": "hello",
        "rect": {
          "left": 10,
          "bottom": 10,
          "right": 30,
          "top": 30
        }
      }
    },
    {
      "name": "ink carries one stroke, because the platforms disagree about many",
      "wire": {
        "v": 1,
        "sequence": 2,
        "sessionId": "presenter",
        "origin": "local",
        "documentFingerprint": "abc12345-900",
        "change": {
          "kind": "edit",
          "edit": {
            "kind": "inkAdded",
            "page": 1,
            "stroke": [
              {
                "x": 10,
                "y": 10
              },
              {
                "x": 50,
                "y": 50
              },
              {
                "x": 90,
                "y": 20
              }
            ],
            "color": {
              "red": 0,
              "green": 90,
              "blue": 220,
              "alpha": 255
            },
            "lineWidth": 3
          }
        }
      },
      "expect": {
        "kind": "inkAdded",
        "page": 1,
        "strokePointCount": 3,
        "lineWidth": 3
      }
    },
    {
      "name": "a removal carries only an index, which is why the fingerprint exists",
      "wire": {
        "v": 1,
        "sequence": 3,
        "sessionId": "presenter",
        "origin": "local",
        "documentFingerprint": "abc12345-900",
        "change": {
          "kind": "edit",
          "edit": {
            "kind": "annotationRemoved",
            "page": 2,
            "index": 4
          }
        }
      },
      "expect": {
        "kind": "annotationRemoved",
        "page": 2,
        "index": 4
      }
    },
    {
      "name": "a field value carries the annotation index it belongs to",
      "wire": {
        "v": 1,
        "sequence": 4,
        "sessionId": "presenter",
        "origin": "local",
        "documentFingerprint": "abc12345-900",
        "change": {
          "kind": "edit",
          "edit": {
            "kind": "fieldTextSet",
            "page": 0,
            "annotationIndex": 1,
            "value": "typed"
          }
        }
      },
      "expect": {
        "kind": "fieldTextSet",
        "page": 0,
        "annotationIndex": 1,
        "value": "typed"
      }
    },
    {
      "name": "a redaction carries its targets so the peer redacts the same regions",
      "wire": {
        "v": 1,
        "sequence": 5,
        "sessionId": "presenter",
        "origin": "local",
        "documentFingerprint": "abc12345-900",
        "change": {
          "kind": "edit",
          "edit": {
            "kind": "redacted",
            "targets": [
              {
                "kind": "region",
                "pageIndex": 0,
                "rect": {
                  "left": 1,
                  "bottom": 2,
                  "right": 3,
                  "top": 4
                }
              },
              {
                "kind": "textMatches",
                "query": "account number"
              }
            ]
          }
        }
      },
      "expect": {
        "kind": "redacted",
        "targetCount": 2,
        "firstTargetKind": "region",
        "secondQuery": "account number"
      }
    }
  ]
}
