{
  "name": "@pdfiumkit/web",
  "version": "0.1.0",
  "description": "PDF SDK for the web, built on PDFium",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/host.d.ts",
      "import": "./dist/worker/host.js"
    },
    "./vendor/*": "./vendor/*"
  },
  "files": [
    "dist",
    "vendor",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "stage-vendor": "node scripts/stage-vendor.mjs",
    "build": "npm run stage-vendor && tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test \"dist-test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.4"
  }
}
